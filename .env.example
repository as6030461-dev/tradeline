# Is file ko copy karke ".env" naam do aur values bharo. .env ko kabhi GitHub par mat daalo.
PORT=3000
BROKER=demo            # demo (free, simulated) ya upstox
ADMIN_KEY=koi-lamba-secret-password
ENABLE_LIVE_ORDERS=false   # true tabhi karo jab pura test ho chuka ho

# Sirf BROKER=upstox ke liye
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/callback

# Email OTP (free). SMTP khali chhodo to OTP terminal me dikhega.
# Gmail: 2-step verification on karo, phir "App password" banao.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
